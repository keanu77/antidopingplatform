{
  "name": "sports-doping-platform",
  "version": "1.0.0",
  "description": "Sports Doping Cases Database Platform",
  "main": "server.js",
  "engines": {
    "node": "18.x"
  },
  "scripts": {
    "build": "cd frontend && npm install && npm run build",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "install:all": "npm run install:backend && npm run install:frontend && npm install",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:frontend": "cd frontend && npm test",
    "knip": "knip",
    "depcheck": "depcheck"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "mongodb": "^6.18.0",
    "mongoose": "^7.5.0"
  },
  "devDependencies": {
    "depcheck": "^1.4.7",
    "knip": "^6.24.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "sports",
    "doping",
    "database",
    "education",
    "api",
    "fullstack"
  ],
  "author": "",
  "license": "MIT"
}
