{
  "name": "sports-doping-platform",
  "version": "1.0.0",
  "description": "Sports Doping Cases Database Platform",
  "main": "server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "cd frontend && npm install && npm run build",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "install:all": "npm run install:backend && npm run install:frontend && npm install",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:frontend": "cd frontend && npm test",
    "knip": "knip",
    "data:rebuild": "node scripts/rebuild-dataset.mjs",
    "data:reviewed": "python3 scripts/build-reviewed-cases.py && node scripts/rebuild-dataset.mjs",
    "test:reviewed": "node --test tests/reviewed-cases.test.mjs",
    "cf:build": "npm --prefix frontend run build",
    "cf:deploy": "npm run cf:build && wrangler pages deploy frontend/dist --project-name antidoping-platform --branch main --commit-dirty=true",
    "cf:migrate": "node scripts/migrate-feedback.mjs apply",
    "smoke": "node tests/smoke/cloudflare-api.smoke.mjs",
    "audit:completion": "node scripts/audit-new-case-completion.mjs",
    "test:api": "node --test tests/cloudflare-contract.test.mjs",
    "test:rules": "node --test tests/education-rules.test.mjs",
    "cf:migrate:status": "node scripts/migrate-feedback.mjs status",
    "cf:migrate:baseline": "node scripts/migrate-feedback.mjs baseline",
    "test:migrations:local": "node --test tests/migrations/local.test.mjs",
    "check:live": "node scripts/check-live.mjs",
    "check:budget": "node scripts/build-budget.mjs",
    "check:html": "node scripts/check-built-html.mjs",
    "drugs:import": "python3 scripts/import-tfda-drugs.py --download",
    "drugs:assets": "node scripts/prepare-drug-assets.mjs",
    "drugs:audit": "node scripts/audit-drug-coverage.mjs",
    "drugs:check-target": "node scripts/audit-drug-coverage.mjs --require-target",
    "drugs:aliases": "node scripts/build-drug-source-aliases.mjs",
    "drugs:references:collect": "python3 scripts/collect-drug-reference-evidence.py",
    "drugs:references:audit": "node scripts/audit-drug-reference-evidence.mjs",
    "drugs:review-import": "node scripts/import-drug-reference-decisions.mjs",
    "drugs:review-queue": "node scripts/prioritize-drug-review.mjs",
    "drugs:update": "python3 scripts/update-drug-catalog.py --download",
    "test:drug-updates": "python3 -m unittest discover -s tests -p 'test_drug_update.py' && python3 -m unittest discover -s tests -p 'test_reference_evidence.py' && node --test tests/drug-coverage.test.mjs tests/ingredient-identities.test.mjs tests/drug-reference-decisions.test.mjs",
    "foods:import": "python3 scripts/import-food-catalog.py --download",
    "herbs:import": "python3 scripts/import-herbal-catalog.py",
    "test:drugs": "python3 -m unittest discover -s tests -p 'test_*import.py' && node --test tests/drug-catalog.test.mjs tests/drug-worker.test.mjs"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "mongodb": "^6.18.0",
    "mongoose": "^8.24.1"
  },
  "devDependencies": {
    "knip": "^6.24.0",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.9",
    "wrangler": "4.125.0"
  },
  "keywords": [
    "sports",
    "doping",
    "database",
    "education",
    "api",
    "fullstack"
  ],
  "author": "",
  "license": "MIT",
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.29.1"
  }
}
