# 服務器配置
PORT=8080
NODE_ENV=production

# 數據庫配置
MONGODB_URI=mongodb://localhost:27017/sports-doping-db

# JWT 配置 (可選，如果啟用身份驗證)
JWT_SECRET=your-secret-key-here

# CORS 配置 (可選)
CORS_ORIGIN=*

# 其他配置
API_VERSION=v1

# ─── 每日回饋彙整信（GET /api/cron/feedback-digest）───
# 設定 + 驗證用一鍵腳本：scripts/setup-digest-cron.sh（避免 CRON_SECRET 401 來回）

# cron 驗證密鑰。外部排程打 endpoint 時帶 header：x-cron-secret: <此值>
# 產生：openssl rand -hex 32。★ 改此值後必須 redeploy 才生效（401 頭號原因）
CRON_SECRET=

# 彙整信收件人（可逗號分隔多個）。沒設則 digest 不寄信
FEEDBACK_DIGEST_TO=

# Zeabur ZSend 郵件 API（非 SMTP）。沒設 ZSEND_API_KEY 則不寄信
# 取得：Zeabur dashboard → ZSend 服務 → API Key
ZSEND_API_KEY=
# 寄件地址（需為 ZSend 已驗證網域），預設「運動禁藥案例平台 <noreply@sportsmedicine.tw>」
ZSEND_FROM=